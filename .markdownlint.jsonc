{
  // All rules stay enabled by default; we only relax the following.
  //
  // MD013 (line-length): disabled. An 80-character cap is arbitrary for prose
  // and changelogs, and the VS Code markdownlint extension already disables it
  // by default — this keeps the CLI (markdownlint-cli2) consistent with the editor.
  "MD013": false,

  // MD024 (no-duplicate-heading): only flag duplicate headings that are siblings.
  // A Keep a Changelog file intentionally repeats "### Added" / "### Changed" etc.
  // under each version section; those live under different parents, so they're fine.
  "MD024": { "siblings_only": true }
}
